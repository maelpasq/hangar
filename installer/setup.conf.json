{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hangar Setup",
  "mainBinaryName": "hangar-setup",
  "version": "../package.json",
  "identifier": "studio.pamal.hangar.setup",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../src-tauri/icons/icon.ico", "../src-tauri/icons/32x32.png"],
    "publisher": "pamal Studio",
    "copyright": "Copyright (c) 2026 pamal Studio"
  }
}
