{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Fenêtre principale : permissions minimales et toutes les commandes de Hangar sauf celles du menu de l'icône",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-is-maximized",
    "core:window:allow-unminimize",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-set-fullscreen",
    "updater:default",
    "process:allow-restart",
    "allow-scan-games",
    "allow-load-state",
    "allow-save-state",
    "allow-load-library",
    "allow-save-library",
    "allow-launch-game",
    "allow-install-game",
    "allow-stop-game",
    "allow-show-launchers",
    "allow-install-progress",
    "allow-steam-downloads",
    "allow-show-steam-downloads",
    "allow-install-targets",
    "allow-open-folder",
    "allow-resolve-steam-id",
    "allow-search-steam",
    "allow-image",
    "allow-find-artwork",
    "allow-set-steamgriddb-key",
    "allow-pick-exe",
    "allow-pick-folder",
    "allow-pick-image",
    "allow-game-info",
    "allow-exe-icon",
    "allow-folder-size",
    "allow-set-autostart",
    "allow-import-cover",
    "allow-accounts-status",
    "allow-connect-steam",
    "allow-connect-account",
    "allow-disconnect-account",
    "allow-open-link",
    "allow-report-bug",
    "allow-open-web-game",
    "allow-uninstall-game",
    "allow-update-game",
    "allow-set-desktop",
    "allow-set-tray-recents",
    "allow-set-presence",
    "allow-mc-versions",
    "allow-mc-install",
    "allow-mc-pack",
    "allow-mc-pack-install",
    "allow-mc-launch",
    "allow-mc-account",
    "allow-mc-login-start",
    "allow-mc-login-finish",
    "allow-mc-logout",
    "allow-mc-select",
    "allow-mc-login-cancel"
  ]
}
