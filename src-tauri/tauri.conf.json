{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hangar",
  "version": "1.0.0",
  "identifier": "studio.pamal.hangar",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Hangar",
        "width": 1320,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "center": true,
        "backgroundColor": "#0b0c10"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://*.steamstatic.com https://*.akamaihd.net; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
