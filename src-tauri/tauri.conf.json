{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hangar",
  "version": "../package.json",
  "identifier": "studio.pamal.hangar",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Hangar",
        "width": 1320,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "center": true,
        "backgroundColor": "#0a0b0f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self' http://localhost:1420; img-src 'self' asset: http://asset.localhost data: http://localhost:1420; style-src 'self' 'unsafe-inline' http://localhost:1420; script-src 'self' http://localhost:1420; font-src 'self' data: http://localhost:1420; connect-src ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPLOCALDATA/cache/**",
          "$APPDATA/covers/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdFRTA1QjYzNTcxOTcyNDcKUldSSGNobFhZMXZnZnNGME44SjhlV3ZWN01rNUE1VzE4Nlc2dE5mbkNlK2ZTWE1qK0poZGZja3EK",
      "endpoints": [
        "https://github.com/maelpasq/hangar/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
